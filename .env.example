# Where the API is. Empty means "the same origin as this page", which is how it
# is deployed and what the dev server's proxy imitates.
VITE_API_BASE=

# Keycloak. The console signs in through the browser, not with a password typed
# into a page of ours — see src/auth/session.ts for why.
# Character for character the backend's Keycloak:Issuer. `localhost` and
# `127.0.0.1` are the same machine and not the same issuer.
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/islapay
VITE_OIDC_CLIENT_ID=islapay-console
